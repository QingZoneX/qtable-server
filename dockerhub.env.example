# QTable Docker Hub consumer example
# Copy to .env, replace CHANGE_ME values, and never commit the resulting .env.

QTABLE_IMAGE=qingzonex/qtable:0.1.2-alpha
QTABLE_UI_IMAGE=qingzonex/qtable-ui:0.1.2-alpha

POSTGRES_USER=qtable
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=qtable

# Generate a long random application signing key.
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
JWT_ACCEPT_LEGACY_TOKENS=false

# Must be exactly a Fernet key. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

ATTACHMENT_STORAGE_ENABLED=true
ATTACHMENT_S3_ACCESS_KEY=qtable
ATTACHMENT_S3_SECRET_KEY=CHANGE_ME_OBJECT_STORAGE_SECRET
ATTACHMENT_S3_BUCKET=qtable
ATTACHMENT_S3_COMPOSE_ENDPOINT=minio:9000
ATTACHMENT_S3_COMPOSE_SECURE=false
MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z

QTABLE_WEB_URL=http://localhost:9100
RESET_PASSWORD_URL_BASE=http://localhost:9100/reset-password

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Host exposure. Internal services stay loopback-only by default.
QTABLE_INTERNAL_BIND_HOST=127.0.0.1
QTABLE_UI_BIND_HOST=0.0.0.0
QTABLE_API_PORT=9000
QTABLE_UI_PORT=9100
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9001
MINIO_CONSOLE_HOST_PORT=9002

# For a single QTable replica, migrations can run at container startup.
# Multi-replica production deployments should run migrations once as a separate job
# and then set this to false for application replicas.
QTABLE_RUN_MIGRATIONS=true
