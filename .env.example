# QTable example configuration
#
# PostgreSQL is the recommended and default database for QTable development
# and self-hosted deployment. Copy this file to .env and adjust values:
#
#   cp .env.example .env
#
# Never commit the resulting .env file or real credentials.

# ==================================================
# Environment
# ==================================================
APP_ENV=development

# ==================================================
# Storage / Database
# ==================================================
DATA_BACKEND=db
DATABASE_MODE=postgres

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=qtable

# For the explicit SQLite fallback, use .env.sqlite.example.

# ==================================================
# Redis
# ==================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ==================================================
# Attachments / S3-compatible object storage
# ==================================================
# The canonical Docker Compose stack starts MinIO and uses this same credential
# pair for MinIO and the QTable API. These example credentials are for local
# development only; replace both values before any production deployment.
ATTACHMENT_STORAGE_ENABLED=true
# Runtime endpoint for a QTable process started directly on the host.
ATTACHMENT_S3_ENDPOINT=localhost:9001
ATTACHMENT_S3_ACCESS_KEY=qtable_local
ATTACHMENT_S3_SECRET_KEY=change_me_attachment_storage_secret
ATTACHMENT_S3_BUCKET=qtable
# Optional region for providers that require one (for example us-east-1).
ATTACHMENT_S3_REGION=
ATTACHMENT_S3_SECURE=false
ATTACHMENT_MAX_BYTES=52428800
ATTACHMENT_CLEANUP_BATCH_SIZE=100
ATTACHMENT_CLEANUP_INTERVAL_SECONDS=60
# Upload intents are durable before the S3 write. Only intents older than this
# grace are treated as abandoned, so slow in-flight uploads are not reclaimed.
# Values below 60 seconds are rejected; keep the default unless you have measured
# your deployment's worst-case upload duration and intentionally choose otherwise.
ATTACHMENT_UPLOAD_PENDING_GRACE_SECONDS=3600

# Compose maps its container-network endpoint into the runtime
# ATTACHMENT_S3_ENDPOINT setting. Keep these defaults for the bundled MinIO.
# To use an external provider from Compose, set its host[:port] and TLS flag here.
ATTACHMENT_S3_COMPOSE_ENDPOINT=minio:9000
ATTACHMENT_S3_COMPOSE_SECURE=false

# Compose exposes MinIO's S3 API and admin console on these host ports.
MINIO_API_HOST_PORT=9001
MINIO_CONSOLE_HOST_PORT=9002
# Optional reproducible MinIO source tag used by docker/minio/Dockerfile.
MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z

# ==================================================
# QTable / AI endpoints
# ==================================================
QTABLE_WEB_URL=http://localhost:9100
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Provider API keys are configured through QTable's encrypted AI configuration
# flow. Do not place real DeepSeek/OpenAI API keys in this file.

# ==================================================
# Security / QingZone identity
# ==================================================
# For production:
# - set APP_ENV=production
# - replace SECRET_KEY with a long random value
# - set a stable ENCRYPTION_KEY
# - replace the attachment storage credentials above
# - keep plain PKCE and dynamic client registration disabled
# - keep password reset debug tokens disabled and rate limiting enabled
SECRET_KEY=development_secret_key_change_me
JWT_ISSUER=qtable
JWT_AUDIENCE=qingzone
JWT_DEFAULT_SCOPE="openid profile email qtable"
JWT_ACCEPT_LEGACY_TOKENS=true
OAUTH_ALLOW_PLAIN_PKCE=false
OAUTH_ALLOW_DYNAMIC_CLIENT_REGISTRATION=false
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# Password reset security. The API always uses a generic forgot-password response
# in production. Raw reset tokens are never returned unless development/test
# explicitly opts in below; production refuses to start if that flag is true.
# Abuse limits are keyed by normalized target email and reset-token hash in Redis.
# Client-IP headers are deliberately not trusted without a trusted-proxy contract.
RESET_TOKEN_EXPIRE_MINUTES=30
RESET_PASSWORD_URL_BASE=http://localhost:9100/reset-password
PASSWORD_RESET_DEBUG_TOKEN_ENABLED=false
PASSWORD_RESET_RATE_LIMIT_ENABLED=true
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_RESET_FORGOT_EMAIL_LIMIT=5
PASSWORD_RESET_SUBMIT_TOKEN_LIMIT=10

# Stable Fernet key recommended for deployment.
# This MUST be the exact output of Fernet.generate_key(); an arbitrary password,
# placeholder, or plain 32-character string is not a valid Fernet key.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If multiple QTable instances share one database, they must use the same key.
# Changing this key makes existing saved AI credentials unreadable until re-saved.
# ENCRYPTION_KEY=

# ==================================================
# Optional SMTP
# ==================================================
# Configure SMTP in production to make password reset deliverable. If SMTP is
# missing or delivery fails, /auth/forgot-password still returns the same generic
# response and never falls back to exposing a reset token. SMTP delivery runs
# after the HTTP response so remote SMTP latency is not an account-enumeration
# signal to the anonymous caller.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
# SMTP_USE_TLS=true

# ==================================================
# Docker build portability
# ==================================================
# Official upstream sources are the default. Leave APT_MIRROR empty for the
# portable OSS path. Regional mirrors are explicit opt-ins only.
PYTHON_IMAGE=python:3.11-slim
APT_MIRROR=
PIP_INDEX_URL=https://pypi.org/simple
# Optional example for a constrained China network:
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
# APT_MIRROR=mirrors.aliyun.com
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# ==================================================
# Docker Compose convenience / host exposure
# ==================================================
QTABLE_UI_CONTEXT=../QTableUI

# Internal data-plane/admin services are intentionally loopback-only by default.
# QTableUI reaches QTable/PostgreSQL/Redis/MinIO over the Compose network, so
# these host mappings exist only for local development and diagnostics. Do not
# change QTABLE_INTERNAL_BIND_HOST to 0.0.0.0 on an Internet-facing machine
# unless you have an explicit firewall/private-network requirement.
QTABLE_INTERNAL_BIND_HOST=127.0.0.1
# The UI is the user-facing service and may be exposed through a reverse proxy.
QTABLE_UI_BIND_HOST=0.0.0.0

QTABLE_API_PORT=9000
QTABLE_UI_PORT=9100
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
