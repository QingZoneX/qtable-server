# QTable SQLite fallback configuration
#
# SQLite is intended for lightweight evaluation, offline development, and
# constrained single-instance use. PostgreSQL remains the recommended database
# for normal development and deployment.
#
# Copy this file to .env:
#
#   cp .env.sqlite.example .env

APP_ENV=development

# QTable still uses the database-backed storage implementation.
DATA_BACKEND=db
DATABASE_MODE=sqlite
SQLITE_PATH=./qtable.db

# Redis is optional for basic table usage but recommended for AI/agent/cache
# capabilities that rely on it.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

QTABLE_WEB_URL=http://localhost:9100
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

SECRET_KEY=development_secret_key_change_me
JWT_ISSUER=qtable
JWT_AUDIENCE=qingzone
JWT_DEFAULT_SCOPE="openid profile email qtable"
JWT_ACCEPT_LEGACY_TOKENS=true
OAUTH_ALLOW_PLAIN_PKCE=false
OAUTH_ALLOW_DYNAMIC_CLIENT_REGISTRATION=false
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# Optional stable Fernet key for encrypted AI credentials.
# It must be generated by Fernet.generate_key(), not an arbitrary password.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=
